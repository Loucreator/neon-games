PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret
MAX_GAME_FILE_MB=2048

# Supabase PostgreSQL
DATABASE_URL=your_database_connection_string

# Backblaze B2 Storage
B2_BUCKET_NAME=your_bucket_name
B2_ENDPOINT=https://s3.example.com
B2_REGION=your_region
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key

# NEON Diamonds / game integration
ENABLE_D17_RECHARGE=false
D17_RECEIVER_NAME=Your D17 account name
D17_RECEIVER_PHONE=Your D17 phone number
D17_INSTRUCTIONS=Send the payment, then upload the receipt. Admin approval is required.
BATTLE_PASS_PRICE_DIAMONDS=500
